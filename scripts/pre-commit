#!/bin/sh
# Pre-commit hook pro Manta IT web
# Auto-bump cache version (?v=hash) na style.css pri zmenach v CSS nebo HTML
#
# Instalace (jednou):
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Nebo na Windows (Git Bash):
#   cp scripts/pre-commit .git/hooks/pre-commit
#
# Hook se spousti pred kazdym 'git commit', bumpne ?v= ve vsech HTML
# a restaguje JEN ty HTML, ktere uz byly stagovane -- aby se do commitu
# nepribalily nesouvisejici rozdelane zmeny z working tree.

# Skip pokud commit nesahne na style.css ani HTML
changed=$(git diff --cached --name-only --diff-filter=ACM)

echo "$changed" | grep -qE '\.(css|html)$' || exit 0

echo "[pre-commit] CSS nebo HTML zmena -> bump cache version"

# Bumpni cache (pouzije aktualni HEAD hash; pro upcoming commit se to v praxi
# lisi o 1 commit, ale to nevadi - hlavni je ze se zmeni ?v= mezi releasy)
python scripts/bump-cache.py
if [ $? -ne 0 ]; then
  echo "[pre-commit] bump-cache.py selhal, abortuju commit"
  exit 1
fi

# Restaguj jen HTML, ktere uz ve stagi byly (bump je mohl upravit)
echo "$changed" | grep -E '\.html$' | while IFS= read -r f; do
  [ -f "$f" ] && git add "$f"
done

echo "[pre-commit] hotovo, pokracuje commit"
exit 0
