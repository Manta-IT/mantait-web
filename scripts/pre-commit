#!/bin/sh
# Pre-commit hook pro Manta IT web
#
# Instalace (jednou):  sh scripts/install-hooks.sh
#
# Dve veci, v tomhle poradi:
#   1. bump `?v=` na otisk obsahu CSS/JS  (aby lide dostali novou verzi)
#   2. strojova kontrola obsahu           (aby nevysla rozbita)
#
# 8. 9. 2026: krok 2 tu byl az za `exit 0`, takze se od instalace hooku nikdy
# nespustil -- kontrola odkazu, typografie a zakazanych slov nebezela.

changed=$(git diff --cached --name-only --diff-filter=ACM)

# Kontrola obsahu bezi vzdycky, i kdyz commit sahne jen na worker.js nebo
# skripty: nalez muze vzniknout i zmenou registru sluzeb nebo llms.txt.
python scripts/kontrola_webu.py
if [ $? -ne 0 ]; then
  echo "[pre-commit] kontrola_webu.py nasla chyby, abortuju commit"
  exit 1
fi

# Bump jen kdyz commit sahne na CSS nebo HTML.
echo "$changed" | grep -qE '\.(css|js|html)$' || exit 0

echo "[pre-commit] CSS/JS/HTML zmena -> bump cache version"
python scripts/bump-cache.py
if [ $? -ne 0 ]; then
  echo "[pre-commit] bump-cache.py selhal, abortuju commit"
  exit 1
fi

# Restaguj HTML, ktere bump zmenil. Bez omezeni na "uz stagovane" by se do
# commitu pribalily cizi rozdelane zmeny -- proto jen soubory, ktere se
# lisi od indexu A ZAROVEN v nem uz jsou.
git diff --name-only --diff-filter=ACM -- '*.html' | while IFS= read -r f; do
  if echo "$changed" | grep -qxF "$f"; then
    git add "$f"
  fi
done

echo "[pre-commit] hotovo, pokracuje commit"
exit 0
